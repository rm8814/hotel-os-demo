# Hostinger (LiteSpeed/Apache) — demo.upscale.asia: static export of the Hotel OS demo
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# The demo's own logic files keep the same name between versions, so a CDN must not hold them for long. (The page also
# asks for them with the build number in the address, which bypasses an old copy.) Only the hashed /_next/static files
# are safe to cache for a week. LiteSpeed does not support <If>, so the files are named.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  <FilesMatch "^(upx-logic|mobile|tablet|booking-engine|guest-portal)\.js$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>
